{
  "version": 2,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "NODE_ENV=production pnpm --filter @workspace/poultry-manager run build",
  "outputDirectory": "artifacts/poultry-manager/dist/public",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" }
  ]
}
