{
  "version": 2,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm run db:push && pnpm --filter @workspace/poultry-manager run build && node artifacts/api-server/build-vercel.mjs",
  "outputDirectory": "artifacts/poultry-manager/dist/public",
  "framework": null,
  "functions": {
    "api/index.mjs": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" }
  ]
}
