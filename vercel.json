{
  "version": 2,
  "installCommand": "pnpm install --no-frozen-lockfile",
  "buildCommand": "pnpm --filter @workspace/poultry-manager run build && cp -r artifacts/poultry-manager/dist/public dist",
  "outputDirectory": "dist",
  "framework": null,
  "functions": {
    "api/index.mts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" }
  ]
}
